            <div type="edition" xml:lang="grc" xml:space="preserve">
            <ab>
                        <lb n="1"/>[- -τ]ō Ἰητρō<!--Greek text here  -->
            </ab>
         </div>
            <div type="apparatus">
                <listApp>
